@model CarePulse.Models.Entities.DoctorProfile
@{
    ViewData["Title"] = $"Dr. {Model.User?.FullName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card cp-card border-0 p-4 mb-4">
                <div class="d-flex align-items-center gap-3 border-bottom pb-4 mb-4">
                    <div class="bg-primary text-white rounded-circle p-4 fs-1">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1">
                            @Model.Department?.Name Specialist
                        </span>
                        <h3 class="fw-bold text-dark mb-0">Dr. @(Model.User?.FullName ?? "Physician")</h3>
                        <p class="text-secondary small mb-0">@Model.Qualification &bull; License: @Model.LicenseNumber</p>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted d-block text-uppercase fw-semibold">Experience</small>
                            <span class="fs-4 fw-bold text-dark">@Model.ExperienceYears+ Years</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted d-block text-uppercase fw-semibold">Consultation Rate</small>
                            <span class="fs-4 fw-bold text-success">$@Model.ConsultationFee</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted d-block text-uppercase fw-semibold">Consultation Room</small>
                            <span class="fs-5 fw-bold text-dark">@Model.RoomNumber</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-primary mb-2">Physician Biography</h5>
                    <p class="text-secondary">@Model.Bio</p>
                </div>

                <div class="mb-4 p-3 bg-light rounded-3 border">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-clock me-1 text-primary"></i> Working Hours & Schedule</h6>
                    <div class="row g-2 small">
                        <div class="col-md-6">
                            <strong>Working Days:</strong> @Model.WorkingDays
                        </div>
                        <div class="col-md-6">
                            <strong>Consultation Window:</strong> @DateTime.Today.Add(Model.DailyStartTime).ToString("hh:mm tt") &ndash; @DateTime.Today.Add(Model.DailyEndTime).ToString("hh:mm tt")
                        </div>
                        <div class="col-md-6">
                            <strong>Slot Duration:</strong> @Model.SlotDurationMinutes Minutes per Patient
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong> <span class="badge bg-success-subtle text-success">Accepting Appointments</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-controller="Appointments" asp-action="Book" asp-route-doctorId="@Model.Id" class="btn btn-cp-primary btn-lg fw-bold flex-grow-1">
                        <i class="bi bi-calendar-check me-1"></i> Book Appointment with Dr. @(Model.User?.FullName)
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        &larr; Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
