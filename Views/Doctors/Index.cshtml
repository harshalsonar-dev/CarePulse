@model List<CarePulse.Models.Entities.DoctorProfile>
@{
    ViewData["Title"] = "Find Clinical Specialists";
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var selectedDeptId = ViewBag.SelectedDepartmentId as int?;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people text-primary me-2"></i> Clinical Specialists & Doctors
            </h2>
            <p class="text-muted small mb-0">Browse certified physicians with real-time consultation calendars</p>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card cp-card border-0 mb-4 p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Search by physician name or specialty..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="departmentId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Clinical Specialties --</option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Id" selected="@(selectedDeptId == dept.Id ? "selected" : null)">
                            @dept.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-cp-primary w-100">Filter Specialists</button>
                @if (selectedDeptId.HasValue || !string.IsNullOrEmpty(searchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card cp-card border-0 p-5 text-center text-muted">
            <i class="bi bi-person-x fs-1 mb-2"></i>
            <h5>No specialists found matching your search.</h5>
            <p class="small">Try resetting your department or name filter.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var doc in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card cp-card cp-card-hover border-0 h-100">
                        <div class="p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="bg-primary text-white rounded-circle p-3 fs-3">
                                    <i class="bi bi-person-badge"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0">Dr. @(doc.User?.FullName ?? "Physician")</h5>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @doc.Department?.Name
                                    </span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="fw-semibold text-secondary small">@doc.Specialization</div>
                                <div class="text-muted small">@doc.Qualification &bull; @doc.ExperienceYears Yrs Experience</div>
                            </div>

                            <p class="text-muted small mb-3 text-truncate-2" style="min-height: 40px;">
                                @doc.Bio
                            </p>

                            <div class="p-3 bg-light rounded-3 small mb-3 border">
                                <div class="mb-2">
                                    <span class="text-muted d-block small mb-1 fw-semibold">Consultation Days:</span>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var day in (doc.WorkingDays ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <span class="badge bg-white text-primary border shadow-sm">@day.Substring(0, Math.Min(3, day.Length))</span>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Hours:</span>
                                    <span class="fw-semibold">@DateTime.Today.Add(doc.DailyStartTime).ToString("hh:mm tt") &ndash; @DateTime.Today.Add(doc.DailyEndTime).ToString("hh:mm tt")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Consultation Fee:</span>
                                    <span class="fw-bold text-success">$@doc.ConsultationFee</span>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-controller="Appointments" asp-action="Book" asp-route-doctorId="@doc.Id" class="btn btn-cp-primary btn-sm fw-semibold">
                                    <i class="bi bi-calendar-check me-1"></i> Book Appointment
                                </a>
                                <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-outline-secondary btn-sm">
                                    Doctor Profile
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
