@model List<CarePulse.Models.Entities.PatientProfile>
@{
    ViewData["Title"] = "Clinical Patient Registry";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-folder2-open text-primary me-2"></i> Clinical Patient Registry (EHR)
            </h2>
            <p class="text-muted small mb-0">Role-Based Access Control clinical access to patient health records</p>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="card cp-card border-0 mb-4 p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Search patients by name, email, or blood group..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-cp-primary w-100">Search Records</button>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a asp-action="PatientsList" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card cp-card border-0 p-5 text-center text-muted">
            <i class="bi bi-person-x fs-1 mb-2"></i>
            <h5>No patient profiles found matching your search.</h5>
        </div>
    }
    else
    {
        <div class="card cp-card border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-secondary">
                        <tr>
                            <th class="ps-4">Patient Name</th>
                            <th>Contact / Email</th>
                            <th>Blood Group</th>
                            <th>Known Allergies</th>
                            <th>Appointments</th>
                            <th class="text-end pe-4">Clinical Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@(patient.User?.FullName ?? "Patient")</div>
                                    <small class="text-muted">ID: @patient.Id &bull; Policy: @patient.InsurancePolicyNumber</small>
                                </td>
                                <td>
                                    <div>@patient.User?.Email</div>
                                    <small class="text-muted">@(patient.User?.PhoneNumber ?? "No phone")</small>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">
                                        @patient.BloodGroup
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(patient.Allergies))
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            @patient.Allergies
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None Reported</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @patient.Appointments.Count Visits
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Patient" asp-route-id="@patient.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-file-earmark-medical me-1"></i> Open EHR
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
