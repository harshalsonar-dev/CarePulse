@model CarePulse.Models.Entities.ApplicationUser
@{
    ViewData["Title"] = "Administrator Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card cp-card border-0 p-4">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="bg-dark text-white rounded-circle p-3 fs-2">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">@Model.FullName</h4>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            Clinical Operations Administrator
                        </span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Admin Account Email</label>
                        <p class="fw-medium mb-2">@Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Role Authority</label>
                        <p class="fw-medium mb-2">Full Clinical Administration & RBAC Management</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Account Created</label>
                        <p class="fw-medium mb-2">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Account Status</label>
                        <p class="fw-bold text-success mb-2">Active</p>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-cp-primary">
                        <i class="bi bi-speedometer2 me-1"></i> Open Admin Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
